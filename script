    make("TextLabel", {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(0.45, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local button = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0.48, 0, 0, 32),
        BackgroundColor3 = C.panel2,
        Text = tostring(Settings[key]) .. "  ▾",
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = C.accent,
        AutoButtonColor = false,
    }, row)
    corner(button, 7)

    local index = table.find(options, Settings[key]) or 1
    button.MouseButton1Click:Connect(function()
        index = index % #options + 1
        Settings[key] = options[index]
        button.Text = tostring(Settings[key]) .. "  ▾"
    end)
end

local function buildTab(name)
    refreshTab()
    activeTab = name

    if name == "AIMBOT" then
        section("Targeting controls")
        toggle("Aimbot", "Aimbot", "Setting for your own game's targeting system")
        toggle("Silent Aim", "SilentAim")
        toggle("Triggerbot", "Triggerbot")
        dropdown("Hitbox selection", "HeadSelection", {"Head", "Torso", "HumanoidRootPart"})
        slider("Maximum aim distance", "MaxAimDistance", 50, 2000, 0)
        toggle("Skip ADS", "SkipADS")
        toggle("Skip Roll", "SkipRoll")
        toggle("Show FOV", "ShowFOV")
        slider("FOV size", "FOVSize", 20, 500, 0)
        toggle("Team check", "TeamCheck", "Useful for team-aware game mechanics")

    elseif name == "VISUALS" then
        section("Visual options")
        toggle("Highlight ESP", "HighlightESP")
        toggle("Box ESP", "BoxESP")
        toggle("Corner Box", "CornerBox")
        toggle("Skeleton ESP", "SkeletonESP")
        toggle("Name Tags", "NameTags")
        toggle("Health Bar", "HealthBar")
        toggle("Distance ESP", "DistanceESP")
        toggle("Head Dot", "HeadDot")
        toggle("Tracers", "Tracers")
        slider("Maximum visual distance", "MaxESPDistance", 50, 3000, 0)

    elseif name == "EXPLOITS" then
        section("Weapon tuning")
        toggle("Rapid Fire", "RapidFire", "Configure only in your own game")
        slider("Rate of fire", "RateOfFire", 1, 60, 0)
        toggle("Damage changer", "DamageChanger", "Use server-validated weapon settings")
        slider("Damage value", "DamageValue", 1, 500, 0)

    elseif name == "SETTINGS" then
        section("Interface")
        slider("UI scale", "UIScale", 0.7, 1.3, 2)

        local info = make("TextLabel", {
            Size = UDim2.new(1, -4, 0, 70),
            BackgroundColor3 = C.panel,
            Text = "PEEP  •  KEYLESS\nSettings are stored locally while this UI runs.\nConnect the settings to your own game systems.",
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = C.muted,
            TextWrapped = true,
        }, content)
        corner(info, 9)
    end

    content.CanvasPosition = Vector2.zero
end

for i, name in ipairs({"AIMBOT", "VISUALS", "EXPLOITS", "SETTINGS"}) do
