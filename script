    label(holder, "◈  " .. text, 10, UDim2.fromOffset(3, 3),
        Enum.Font.GothamBold, C.muted)
end

local function card(page, height)
    local f = make("Frame", {
        Size = UDim2.new(1, -4, 0, height or 48),
        BackgroundColor3 = C.row,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0
    }, page)
    round(f, 10)
    return f
end

local function toggle(page, name, description)
    local f = card(page, description and 57 or 44)
    label(f, name, 12, UDim2.fromOffset(12, 4),
        Enum.Font.GothamMedium).Size = UDim2.new(1, -90, 0, 23)

    if description then
        local d = label(f, description, 9,
            UDim2.fromOffset(12, 29), Enum.Font.Gotham, C.muted)
        d.Size = UDim2.new(1, -85, 0, 15)
    end

    local switch = make("TextButton", {
        Position = UDim2.new(1, -57, 0.5, -11),
        Size = UDim2.fromOffset(43, 22),
        BackgroundColor3 = C.track,
        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, f)
    round(switch, 12)

    local dot = make("Frame", {
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = C.silver,
        BorderSizePixel = 0
    }, switch)
    round(dot, 10)

    state[name] = false
    switch.MouseButton1Click:Connect(function()
        state[name] = not state[name]
        local enabled = state[name]
        TweenService:Create(switch, TweenInfo.new(0.16), {
            BackgroundColor3 = enabled and C.accent or C.track
        }):Play()
        TweenService:Create(dot, TweenInfo.new(0.16), {
            Position = enabled and UDim2.new(1, -19, 0, 3)
                or UDim2.fromOffset(3, 3),
            BackgroundColor3 = enabled and C.bg or C.silver
        }):Play()
        if callbacks[name] then callbacks[name](enabled) end
    end)
    return f
end

local function slider(page, name, min, max, default)
    local f = card(page, 65)
    label(f, name, 11, UDim2.fromOffset(12, 5),
        Enum.Font.GothamMedium).Size = UDim2.new(0.72, 0, 0, 20)

    local value = make("TextLabel", {
        Position = UDim2.new(0.70, 0, 0, 5),
        Size = UDim2.new(0.27, -8, 0, 20),
        BackgroundTransparency = 1,
        TextColor3 = C.silver,
        Text = tostring(default),
        TextSize = 11,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Right
    }, f)

    local track = make("TextButton", {
        Position = UDim2.new(0, 12, 0, 39),
        Size = UDim2.new(1, -24, 0, 7),
        BackgroundColor3 = C.track,
        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, f)
    round(track, 5)

    local ratio = math.clamp((default-min)/(max-min), 0, 1)
    local fill = make("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0
    }, track)
    round(fill, 5)

    local knob = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        BackgroundColor3 = C.silver,
        BorderSizePixel = 0
    }, track)
    round(knob, 10)

    local function update(x)
        local r = math.clamp(
            (x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max-min)*r + 0.5)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        value.Text = tostring(v)
        state[name] = v
        if callbacks[name] then callbacks[name](v) end
    end

    state[name] = default
    track.MouseButton1Down:Connect(function()
        update(UIS:GetMouseLocation().X)
    end)
    UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            and track:IsDescendantOf(gui) then
            -- Slider is updated while dragging over its own track.
            local p = UIS:GetMouseLocation()
            if p.X >= track.AbsolutePosition.X - 4
                and p.X <= track.AbsolutePosition.X + track.AbsoluteSize.X + 4
                and p.Y >= track.AbsolutePosition.Y - 16
                and p.Y <= track.AbsolutePosition.Y + track.AbsoluteSize.Y + 16 then
                update(p.X)
            end
        end
    end)
    return f
end

local function dropdown(page, name, options, default)
    local f = card(page, 49)
    label(f, name, 11, UDim2.fromOffset(12, 12),
        Enum.Font.GothamMedium).Size = UDim2.new(0.45, 0, 0, 22)

    local index = table.find(options, default) or 1
    local b = make("TextButton", {
        Position = UDim2.new(0.48, 0, 0, 8),
        Size = UDim2.new(0.48, -8, 0, 32),
        BackgroundColor3 = C.bg,
        Text = options[index] .. "  ▾",
        TextColor3 = C.silver,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        BorderSizePixel = 0
    }, f)
    round(b, 8)
    state[name] = options[index]
    b.MouseButton1Click:Connect(function()
        index = index % #options + 1
        state[name] = options[index]
        b.Text = options[index] .. "  ▾"
        if callbacks[name] then callbacks[name](state[name]) end
    end)
    return f
end

