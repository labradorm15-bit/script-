        TextXAlignment = Enum.TextXAlignment.Left,
    }, content)
end

local function toggle(label, key)
    local button = make("TextButton", {
        Size = UDim2.new(1, -12, 0, 34),
        BackgroundColor3 = DARK,
        Text = "",
        AutoButtonColor = true,
    }, content)
    corner(button)

    local text = make("TextLabel", {
        Size = UDim2.new(1, -65, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = WHITE,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    local state = make("TextLabel", {
        Size = UDim2.fromOffset(48, 25),
        Position = UDim2.new(1, -54, 0.5, -12),
        BackgroundColor3 = settings[key] and PURPLE or PANEL,
        Text = settings[key] and "ON" or "OFF",
        TextColor3 = WHITE,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
    }, button)
    corner(state)

    button.MouseButton1Click:Connect(function()
        settings[key] = not settings[key]
        state.Text = settings[key] and "ON" or "OFF"
        state.BackgroundColor3 = settings[key] and PURPLE or PANEL
    end)
end

local function slider(label, key, minValue, maxValue)
    local frame = make("Frame", {
        Size = UDim2.new(1, -12, 0, 62),
        BackgroundColor3 = DARK,
    }, content)
    corner(frame)

    local caption = make("TextLabel", {
        Size = UDim2.new(1, -16, 0, 26),
        Position = UDim2.fromOffset(8, 2),
        BackgroundTransparency = 1,
        TextColor3 = WHITE,
        Text = label .. ": " .. tostring(settings[key]),
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local bar = make("TextButton", {
        Size = UDim2.new(1, -20, 0, 12),
        Position = UDim2.fromOffset(10, 38),
        BackgroundColor3 = PANEL,
        Text = "",
    }, frame)
    corner(bar)

    local fill = make("Frame", {
        Size = UDim2.new(
            (settings[key] - minValue) / (maxValue - minValue), 0, 1, 0
        ),
        BackgroundColor3 = PURPLE,
        BorderSizePixel = 0,
    }, bar)
    corner(fill)

    local function update(x)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1
        )
        settings[key] = math.floor(
            minValue + alpha * (maxValue - minValue)
        )
        fill.Size = UDim2.fromScale(alpha, 1)
        caption.Text = label .. ": " .. settings[key]

        if key == "UIScale" then
            scale.Scale = settings.UIScale / 100
        end
    end

    bar.MouseButton1Click:Connect(function()
        update(UIS:GetMouseLocation().X)
    end)
end

local function buildTab(tab)
    clearContent()

    if tab == "Aim" then
        section("AIM TRAINING")
        toggle("Show FOV", "ShowFOV")
        toggle("Team Check", "TeamCheck")
        slider("FOV Size", "FOVSize", 30, 300)
        slider("Max Target Distance", "AimDistance", 50, 2000)

    elseif tab == "Visuals" then
        section("PLAYER VISUALS")
        toggle("Highlight ESP", "Highlight")
        toggle("Box ESP", "Boxes")
        toggle("Corner Box", "CornerBox")
        toggle("Skeleton ESP", "Skeleton")
        toggle("Name Tags", "NameTags")
        toggle("Health Bar", "HealthBar")
        toggle("Distance ESP", "Distance")
        toggle("Head Dot", "HeadDot")
        toggle("Tracers", "Tracers")
        slider("Max ESP Distance", "ESPDistance", 50, 2000)

    elseif tab == "Weapons" then
        section("OWN-GAME WEAPON TESTING")
        toggle("Rapid Fire Test", "RapidFire")
        slider("Rate of Fire", "FireRate", 1, 30)
        slider("Test Damage Value", "Damage", 1, 100)

    elseif tab == "Settings" then
        section("INTERFACE")
        slider("UI Scale (%)", "UIScale", 70, 150)
    end
end

