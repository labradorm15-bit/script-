local pages = {}
local tabButtons = {}
local activeTab = "AIMBOT"

local function selectTab(name)
    activeTab = name
    for key, page in pairs(pages) do
        page.Visible = key == name
    end
    for key, button in pairs(tabButtons) do
        local selected = key == name
        button.TextColor3 = selected and C.silver or C.muted
        button.BackgroundColor3 = selected and C.row or C.bg
        button.TextTransparency = selected and 0 or 0.15
    end
end

local function createPage(name, index)
    local button = make("TextButton", {
        Name = name .. "Tab",
        LayoutOrder = index,
        Size = UDim2.new(1/3, -5, 1, 0),
        BackgroundColor3 = C.bg,
        Text = name,
        TextColor3 = C.muted,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, tabs)
    round(button, 8)
    tabButtons[name] = button

    local page = make("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.muted,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false
    }, body)

    make("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    make("UIPadding", {
        PaddingBottom = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 4)
    }, page)

    pages[name] = page
    button.MouseButton1Click:Connect(function()
        selectTab(name)
    end)
    return page
end

local function section(page, text)
