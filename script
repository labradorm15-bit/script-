-- Utility to create a screen-space line.
local function newLine(parent, name)
    local line = Instance.new("Frame")
    line.Name = name
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.Size = UDim2.fromOffset(0, 2)
    line.BackgroundColor3 = C.accent
    line.BorderSizePixel = 0
    line.Visible = false
    line.ZIndex = 35
    line.Parent = parent
    return line
end

local function drawLine(line, x1, y1, x2, y2, thickness)
    local dx, dy = x2 - x1, y2 - y1
    line.Position = UDim2.fromOffset(x1, y1)
    line.Size = UDim2.fromOffset(
        math.sqrt(dx * dx + dy * dy),
        thickness or 2
    )
    line.Rotation = math.deg(math.atan2(dy, dx))
    line.Visible = true
end

local function hideLine(line)
    line.Visible = false
end

local esp = {}

local function makeESP(target)
    if target == player or esp[target] then
        return
    end

    local folder = Instance.new("Folder")
    folder.Name = "PEEP_" .. target.UserId
    folder.Parent = overlay

    local box = Instance.new("Frame")
    box.Name = "Box"
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.ZIndex = 32
    box.Parent = folder

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = C.accent
    boxStroke.Thickness = 1.5
    boxStroke.Parent = box

    local cornerLines = {}
    for i = 1, 8 do
        cornerLines[i] = newLine(folder, "Corner" .. i)
    end

    local tracer = newLine(folder, "Tracer")

    local headDot = Instance.new("Frame")
    headDot.Name = "HeadDot"
    headDot.Size = UDim2.fromOffset(7, 7)
    headDot.BackgroundColor3 = C.silver
    headDot.BorderSizePixel = 0
    headDot.Visible = false
    headDot.ZIndex = 37
    headDot.Parent = folder

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = headDot

    local tag = Instance.new("TextLabel")
    tag.Name = "PlayerTag"
    tag.Size = UDim2.fromOffset(220, 20)
    tag.BackgroundTransparency = 1
    tag.Font = Enum.Font.GothamBold
    tag.TextSize = 11
    tag.TextColor3 = C.silver
    tag.TextStrokeTransparency = 0.25
    tag.TextXAlignment = Enum.TextXAlignment.Center
    tag.Visible = false
    tag.ZIndex = 37
    tag.Parent = folder

    local healthBack = Instance.new("Frame")
    healthBack.Name = "HealthBackground"
    healthBack.BackgroundColor3 = C.track
    healthBack.BorderSizePixel = 0
    healthBack.Visible = false
    healthBack.ZIndex = 36
    healthBack.Parent = folder

    local healthFill = Instance.new("Frame")
    healthFill.Name = "HealthFill"
    healthFill.AnchorPoint = Vector2.new(0, 1)
    healthFill.Position = UDim2.new(0, 0, 1, 0)
    healthFill.Size = UDim2.fromScale(1, 1)
    healthFill.BackgroundColor3 = Color3.fromRGB(100, 230, 150)
    healthFill.BorderSizePixel = 0
    healthFill.ZIndex = 37
    healthFill.Parent = healthBack

    local skeletonLines = {}
    for i = 1, 12 do
        skeletonLines[i] = newLine(folder, "Skeleton" .. i)
    end

    local highlight

    esp[target] = {
        folder = folder,
        box = box,
        cornerLines = cornerLines,
        tracer = tracer,
        headDot = headDot,
        tag = tag,
        healthBack = healthBack,
        healthFill = healthFill,
        skeletonLines = skeletonLines,
        highlight = highlight,
    }
end

local function hideESP(v)
    v.box.Visible = false
    v.tracer.Visible = false
    v.headDot.Visible = false
    v.tag.Visible = false
    v.healthBack.Visible = false

    for _, line in ipairs(v.cornerLines) do
        hideLine(line)
    end
    for _, line in ipairs(v.skeletonLines) do
        hideLine(line)
    end

    if v.highlight then
        v.highlight.Enabled = false
    end
end

local function screenPoint(part)
    if not Camera or not part then
        return nil
    end

    local p, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or p.Z <= 0 then
        return nil
    end

    return Vector2.new(p.X, p.Y)
end

local skeletonPairsR15 = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
}

local skeletonPairsR6 = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local function updateSkeleton(v, character)
    local pairsToDraw = character:FindFirstChild("UpperTorso")
        and skeletonPairsR15 or skeletonPairsR6

    for i, pair in ipairs(pairsToDraw) do
        local a = character:FindFirstChild(pair[1])
        local b = character:FindFirstChild(pair[2])
        local p1 = a and screenPoint(a)
        local p2 = b and screenPoint(b)
        local line = v.skeletonLines[i]

        if p1 and p2 then
            drawLine(line, p1.X, p1.Y, p2.X, p2.Y, 2)
        else
            hideLine(line)
        end
    end

    for i = #pairsToDraw + 1, #v.skeletonLines do
        hideLine(v.skeletonLines[i])
    end
end

local function updateESP(target, v)
    local character = target.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and character:FindFirstChild("Head")

    if not Camera or not character or not humanoid
        or humanoid.Health <= 0 or not root then
        hideESP(v)
        return
    end

    if state["Team Check"] and target.Team == player.Team then
        hideESP(v)
        return
    end

    local distance = (root.Position - Camera.CFrame.Position).Magnitude
    if distance > (state["Max ESP Distance"] or 500) then
        hideESP(v)
        return
    end

    local rootPos = screenPoint(root)
    local headPos = head and screenPoint(head)

    if not rootPos then
        hideESP(v)
        return
    end

    -- Highlight ESP.
    if state["Highlight ESP"] then
        if not v.highlight or not v.highlight.Parent then
            local h = Instance.new("Highlight")
            h.Name = "PEEP_Highlight"
            h.FillColor = C.accent
            h.OutlineColor = C.silver
            h.FillTransparency = 0.8
            h.OutlineTransparency = 0.15
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = character
            v.highlight = h
        end
        v.highlight.Enabled = true
    elseif v.highlight then
        v.highlight.Enabled = false
    end

    -- Approximate screen-space player bounds.
    local _, bounds = character:GetBoundingBox()
    local height = math.clamp(
        bounds.Y * Camera.ViewportSize.Y / math.max(distance * 1.5, 1),
        12,
        Camera.ViewportSize.Y
    )
    local width = height * 0.48
    local left = rootPos.X - width / 2
    local top = rootPos.Y - height / 2

    -- Box ESP.
    v.box.Visible = state["Box ESP"] and not state["Corner Box"]
    if v.box.Visible then
        v.box.Position = UDim2.fromOffset(left, top)
        v.box.Size = UDim2.fromOffset(width, height)
    end

    -- Corner Box.
    for _, line in ipairs(v.cornerLines) do
        hideLine(line)
    end

    if state["Corner Box"] then
        local cw, ch = width * 0.28, height * 0.2
        local segments = {
            {left, top, left + cw, top},
            {left, top, left, top + ch},
            {left + width - cw, top, left + width, top},
            {left + width, top, left + width, top + ch},
            {left, top + height - ch, left, top + height},
            {left, top + height, left + cw, top + height},
            {left + width - cw, top + height, left + width, top + height},
            {left + width, top + height - ch, left + width, top + height},
        }

        for i, s in ipairs(segments) do
            drawLine(v.cornerLines[i], s[1], s[2], s[3], s[4], 2)
        end
    end

    -- Name tags and distance.
    v.tag.Visible = state["Name Tags"] or state["Distance"]
    if v.tag.Visible then
        local textParts = {}
        if state["Name Tags"] then
            table.insert(textParts, target.DisplayName)
        end
        if state["Distance"] then
            table.insert(textParts, string.format("%d studs", distance))
        end
        v.tag.Text = table.concat(textParts, "  |  ")
        v.tag.Position = UDim2.fromOffset(rootPos.X - 110, top - 21)
    end

    -- Health bar beside the player.
    v.healthBack.Visible = state["Health Bar (Side)"]
    if v.healthBack.Visible then
        v.healthBack.Position = UDim2.fromOffset(left - 7, top)
        v.healthBack.Size = UDim2.fromOffset(4, height)

        local ratio = math.clamp(
            humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1
        )
        v.healthFill.Size = UDim2.new(1, 0, ratio, 0)
        v.healthFill.BackgroundColor3 = Color3.fromRGB(
            math.floor(255 * (1 - ratio)),
            math.floor(220 * ratio),
            80
        )
    end

    -- Head Dot.
    v.headDot.Visible = state["Head Dot"] and headPos ~= nil
    if v.headDot.Visible then
        v.headDot.Position = UDim2.fromOffset(headPos.X - 3.5, headPos.Y - 3.5)
    end

    -- Tracers.
    v.tracer.Visible = state["Tracers"]
    if v.tracer.Visible then
        local viewport = Camera.ViewportSize
        drawLine(
            v.tracer,
            viewport.X / 2,
            viewport.Y,
            rootPos.X,
            rootPos.Y,
            2
        )
    end

    -- Skeleton ESP.
    if state["Skeleton ESP"] then
        updateSkeleton(v, character)
    else
        for _, line in ipairs(v.skeletonLines) do
            hideLine(line)
        end
    end
end

-- Connect existing FOV settings.
callbacks["Show FOV"] = function(enabled)
    fovCircle.Visible = enabled
end

callbacks["FOV Size"] = function(value)
    state["FOV Size"] = value
end

-- Create visual objects for current and future players.
for _, target in ipairs(Players:GetPlayers()) do
    makeESP(target)
end

Players.PlayerAdded:Connect(makeESP)

Players.PlayerRemoving:Connect(function(target)
    local v = esp[target]
    if v then
        if v.highlight then
            v.highlight:Destroy()
        end
        v.folder:Destroy()
        esp[target] = nil
    end
end)

-- Live update loop.
local visualConnection
visualConnection = RunService.RenderStepped:Connect(function()
    if not gui.Parent then
        visualConnection:Disconnect()
        return
    end

    Camera = workspace.CurrentCamera

    if state["Show FOV"] and Camera then
        fovCircle.Visible = true
        local mouse = UIS:GetMouseLocation()
        local radius = state["FOV Size"] or 400

        fovCircle.Position = UDim2.fromOffset(mouse.X, mouse.Y)
        fovCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
    else
        fovCircle.Visible = false
    end

    for target, v in pairs(esp) do
        if target.Parent == Players then
            updateESP(target, v)
        else
            hideESP(v)
        end
    end
end)

