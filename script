local function section(title, order)
    return new("TextLabel", {
        Size = UDim2.new(1, -4, 0, 24),
        BackgroundTransparency = 1,
        Text = "  " .. title,
        TextColor3 = muted,
        TextSize = 11,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = order
    }, scroll)
end

local settings = {}

local function toggle(title, description, order, callback)
    local card = new("Frame", {
        Size = UDim2.new(1, -4, 0, 59),
        BackgroundColor3 = glass,
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        LayoutOrder = order
    }, scroll)
    corner(card, 12)
    stroke(card, silver, 0.78)

    new("TextLabel", {
        Position = UDim2.fromOffset(13, 8),
        Size = UDim2.new(1, -90, 0, 22),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = silver,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)

    new("TextLabel", {
        Position = UDim2.fromOffset(13, 30),
        Size = UDim2.new(1, -90, 0, 17),
        BackgroundTransparency = 1,
        Text = description,
        TextColor3 = muted,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)

    local button = new("TextButton", {
        Position = UDim2.new(1, -62, 0.5, -12),
        Size = UDim2.fromOffset(48, 24),
        Text = "",
        BackgroundColor3 = Color3.fromRGB(54, 57, 65),
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, card)
    corner(button, 12)

    local knob = new("Frame", {
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = silver,
        BorderSizePixel = 0
    }, button)
    corner(knob, 9)

    local enabled = false
    settings[title] = false

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        settings[title] = enabled

        TweenService:Create(button, TweenInfo.new(0.18), {
            BackgroundColor3 = enabled
                and Color3.fromRGB(175, 190, 210)
                or Color3.fromRGB(54, 57, 65)
        }):Play()

        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = enabled
                and UDim2.fromOffset(27, 3)
                or UDim2.fromOffset(3, 3),
            BackgroundColor3 = enabled and black or silver
        }):Play()

        if callback then
            callback(enabled)
        end
    end)
end

