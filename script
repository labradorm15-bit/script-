local function toggle(label, key, description)
    local row = make("Frame", {
        Size = UDim2.new(1, -4, 0, description and 56 or 44),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, content)
    corner(row, 9)
    outline(row, Color3.fromRGB(43, 49, 61), 0.2)

    make("TextLabel", {
        Position = UDim2.fromOffset(12, description and 8 or 0),
        Size = UDim2.new(1, -75, 0, description and 20 or 44),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    if description then
        make("TextLabel", {
            Position = UDim2.fromOffset(12, 29),
            Size = UDim2.new(1, -75, 0, 17),
            BackgroundTransparency = 1,
            Text = description,
            Font = Enum.Font.Gotham,
            TextSize = 9,
            TextColor3 = C.muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
    end

    local switch = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(38, 21),
        BackgroundColor3 = Settings[key] and C.accent2 or C.panel2,
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(switch, 12)

    local knob = make("Frame", {
        Position = Settings[key] and UDim2.new(1, -18, 0.5, -7)
            or UDim2.new(0, 4, 0.5, -7),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0,
    }, switch)
    corner(knob, 10)

    local function update(value)
        Settings[key] = value
        tween(switch, {
            BackgroundColor3 = value and C.accent2 or C.panel2,
        })
        tween(knob, {
            Position = value and UDim2.new(1, -18, 0.5, -7)
                or UDim2.new(0, 4, 0.5, -7),
        })
    end

    switch.MouseButton1Click:Connect(function()
        update(not Settings[key])
    end)
    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if input.Position.X < switch.AbsolutePosition.X then
                update(not Settings[key])
            end
        end
    end)
end

local function slider(label, key, minValue, maxValue, decimals)
    local row = make("Frame", {
        Size = UDim2.new(1, -4, 0, 64),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, content)
    corner(row, 9)
    outline(row, Color3.fromRGB(43, 49, 61), 0.2)

    make("TextLabel", {
        Position = UDim2.fromOffset(12, 8),
        Size = UDim2.new(1, -85, 0, 20),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valueLabel = make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 8),
        Size = UDim2.fromOffset(70, 20),
        BackgroundTransparency = 1,
        Text = tostring(Settings[key]),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = C.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local track = make("TextButton", {
        Position = UDim2.new(0, 12, 0, 39),
        Size = UDim2.new(1, -24, 0, 6),
        BackgroundColor3 = C.panel2,
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(track, 6)

    local initial = math.clamp((Settings[key] - minValue) / (maxValue - minValue), 0, 1)
    local fill = make("Frame", {
        Size = UDim2.new(initial, 0, 1, 0),
        BackgroundColor3 = C.accent2,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 6)

    local dragging = false
    local function setFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        local value = minValue + (maxValue - minValue) * alpha
        if decimals == 0 then
            value = math.floor(value + 0.5)
        elseif decimals then
            local mult = 10 ^ decimals
            value = math.floor(value * mult + 0.5) / mult
        end
        Settings[key] = value
        valueLabel.Text = tostring(value)
        fill.Size = UDim2.new(alpha, 0, 1, 0)

        if key == "UIScale" then
            scale.Scale = value
        end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function dropdown(label, key, options)
    local row = make("Frame", {
        Size = UDim2.new(1, -4, 0, 54),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, content)
    corner(row, 9)
